---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { profile } from '@/data/profile'
import { projects } from '@/data/projects'
import config from '@/site-config'

const MAX_BLOG = 5
const MAX_NOTES = 5
const latestBlogs = sortMDByDate(await getBlogCollection()).slice(0, MAX_BLOG)

const allNotes = await getCollection('notes', ({ data }) => !data.draft)
const latestNotes = [...allNotes]
  .sort(
    (a, b) =>
      new Date(b.data.updatedDate ?? b.data.publishDate).getTime() -
      new Date(a.data.updatedDate ?? a.data.publishDate).getTime()
  )
  .slice(0, MAX_NOTES)

const featuredProjects = projects.slice(0, 3)

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath]) {
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
}

const quickLinks = [
  { title: 'Blog', href: '/blog' },
  { title: 'Notes', href: '/notes' },
  { title: 'Projects', href: '/projects' },
  { title: 'About', href: '/about' }
]
---

<PageLayout meta={{ title: 'Home', description: profile.description }} highlightColor='#5a8f7b'>
  <main class='mt-6 flex w-full flex-col gap-y-10 lg:mt-10'>
    <section id='content-header' class='animate rounded-2xl border bg-muted/30 p-6 sm:p-8'>
      <div class='flex flex-col gap-5 md:flex-row md:items-center'>
        <Image
          src={images[imagePath]()}
          alt={config.logo.alt || 'Profile'}
          class='h-28 w-28 rounded-full border p-1'
          loading='eager'
          fetchpriority='high'
        />
        <div class='flex-1'>
          <h1 class='text-3xl font-semibold sm:text-4xl'>{profile.name}</h1>
          <p class='mt-2 text-muted-foreground'>
            PKU sophomore, {profile.college}
          </p>
          <p class='mt-2 text-muted-foreground'>{profile.intro}</p>
          <p class='mt-2 text-sm text-muted-foreground'>{profile.introZh}</p>
          <div class='mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm'>
            <span class='inline-flex items-center gap-1'>
              <Icon name='earth' class='size-4' />
              {profile.fullSchoolName}
            </span>
            <a href={`mailto:${profile.email}`} class='inline-flex items-center gap-1 hover:underline'>
              <Icon name='email' class='size-4' />
              {profile.email}
            </a>
          </div>
        </div>
      </div>
      <div class='mt-5 flex flex-wrap gap-3'>
        {quickLinks.map((item) => <Button href={item.href} title={item.title} variant='pill' />)}
      </div>
    </section>

    <section id='content' class='animate'>
      <h2 class='text-2xl font-medium'>Research / Interests</h2>
      <ul class='mt-3 flex flex-wrap gap-2'>
        {profile.interests.map((item) => (
          <li class='rounded-full border px-3 py-1 text-sm text-muted-foreground'>{item}</li>
        ))}
      </ul>
    </section>

    <section class='animate'>
      <div class='mb-3 flex items-center justify-between'>
        <h2 class='text-2xl font-medium'>Latest Posts</h2>
        <a href='/blog' class='text-sm text-muted-foreground hover:underline'>
          View all →
        </a>
      </div>
      {latestBlogs.length ? (
        <ul class='flex flex-col gap-y-2'>
          {latestBlogs.map((post) => (
            <li>
              <PostPreview post={post} detailed />
            </li>
          ))}
        </ul>
      ) : (
        <p class='text-muted-foreground'>No posts yet.</p>
      )}
    </section>

    <section class='animate'>
      <div class='mb-3 flex items-center justify-between'>
        <h2 class='text-2xl font-medium'>Latest Notes</h2>
        <a href='/notes' class='text-sm text-muted-foreground hover:underline'>
          View all →
        </a>
      </div>
      {latestNotes.length ? (
        <ul class='grid gap-3 sm:grid-cols-2'>
          {latestNotes.map((note) => (
            <li class='rounded-xl border p-4'>
              <a href={`/notes/${note.id}`} class='text-base font-medium hover:underline'>
                {note.data.title}
              </a>
              <p class='mt-1 text-sm text-muted-foreground'>{note.data.description}</p>
              <p class='mt-2 text-xs text-muted-foreground'>
                {new Date(note.data.updatedDate ?? note.data.publishDate).toLocaleDateString('zh-CN')}
                {' · '}
                {note.data.category}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p class='text-muted-foreground'>No notes yet.</p>
      )}
    </section>

    <section class='animate'>
      <h2 class='mb-3 text-2xl font-medium'>Education</h2>
      <div class='grid gap-3'>
        <Card
          as='a'
          class='edu-card'
          heading='北京大学'
          subheading='数学 / 计算数学'
          date='August 2024 - Present'
          href='https://www.pku.edu.cn/'
        >
          <img
            src='/education/pku-badge.png'
            alt='PKU badge'
            class='edu-badge'
            loading='lazy'
          />
        </Card>
        <Card
          as='a'
          class='edu-card'
          heading='九江一中'
          subheading='High School Education'
          date='September 2021 - June 2024'
          href='https://jjzx.jxfls.com'
        >
          <img
            src='/education/jjzx-badge.png'
            alt='JJZX badge'
            class='edu-badge'
            loading='lazy'
          />
        </Card>
      </div>
    </section>

    <section class='animate'>
      <div class='mb-3 flex items-center justify-between'>
        <h2 class='text-2xl font-medium'>Featured Projects</h2>
        <a href='/projects' class='text-sm text-muted-foreground hover:underline'>
          View all →
        </a>
      </div>
      <ul class='grid gap-3 sm:grid-cols-2 lg:grid-cols-3'>
        {featuredProjects.map((project) => (
          <li class='rounded-xl border p-4'>
            <h3 class='text-lg font-medium'>{project.name}</h3>
            <p class='mt-2 text-sm text-muted-foreground'>{project.description}</p>
            <p class='mt-2 text-xs text-muted-foreground'>Status: {project.status}</p>
            <ul class='mt-2 flex flex-wrap gap-2'>
              {project.tags.map((tag) => (
                <li class='rounded-full bg-muted px-2 py-0.5 text-xs'>{tag}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  </main>
</PageLayout>

<style>
  .edu-card {
    overflow: hidden;
    min-height: 11rem;
    isolation: isolate;
    background: linear-gradient(90deg, rgba(20, 20, 28, 0.95) 0%, rgba(28, 28, 38, 0.92) 55%, rgba(36, 36, 46, 0.9) 100%);
  }

  .edu-card .edu-badge {
    position: absolute;
    right: -6.25rem;
    top: 50%;
    transform: translateY(-50%);
    width: 24rem;
    height: 24rem;
    opacity: 0.34;
    pointer-events: none;
    user-select: none;
    z-index: -1;
    object-fit: contain;
  }

  .edu-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(16, 16, 22, 0.92) 0%, rgba(16, 16, 22, 0.86) 44%, rgba(16, 16, 22, 0.2) 72%, rgba(16, 16, 22, 0.06) 100%);
    pointer-events: none;
    z-index: -1;
  }

  .edu-card :global(h2) {
    color: #d9f4ff;
  }

  @media (max-width: 640px) {
    .edu-card .edu-badge {
      width: 16rem;
      height: 16rem;
      right: -4rem;
      opacity: 0.26;
    }
  }
</style>
