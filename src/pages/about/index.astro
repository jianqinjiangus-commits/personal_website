---
import PageLayout from '@/layouts/CommonPage.astro'
import { profile } from '@/data/profile'
import { skills } from '@/data/skills'

const headings = [
  { depth: 2, slug: 'general-talk', text: 'General Talk' },
  { depth: 2, slug: 'education', text: 'Education' },
  { depth: 2, slug: 'research-interests', text: 'Research Interests' },
  { depth: 2, slug: 'notes-and-writing', text: 'Notes and Writing' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'about-this-site', text: 'About This Site' }
]
---

<PageLayout title='About' {headings}>
  <h2 id='general-talk'>General Talk</h2>
  <p>
    Hi, I am TON. I am currently a sophomore at PKU, studying Mathematics / Computational
    Mathematics.
  </p>
  <p>
    This site is my personal academic and technical space. I use it to organize blogs, course
    notes, paper reading notes, numerical experiments, research logs, and small projects.
  </p>

  <h2 id='education'>Education</h2>
  <ul>
    <li>PKU, Mathematics / Computational Mathematics, sophomore.</li>
    <li>Email: <a href={`mailto:${profile.email}`}>{profile.email}</a></li>
  </ul>

  <h2 id='research-interests'>Research Interests</h2>
  <p>
    My current interests include numerical analysis, scientific computing, PDEs, quantum
    algorithms, Hamiltonian learning, classical shadows, and nonlinear differential equations with
    Carleman linearization.
  </p>
  <ul>
    {profile.interests.map((item) => <li>{item}</li>)}
  </ul>

  <h2 id='notes-and-writing'>Notes and Writing</h2>
  <p>
    The Notes section collects course notes, mathematical derivations, paper reading records, and
    structured study materials. The Blog section contains more polished posts and research logs.
  </p>

  <h2 id='tools'>Tools</h2>
  <p>
    I commonly use LaTeX, Markdown, Python, MATLAB, Git, VS Code, and notebook-based workflows for
    mathematical writing and numerical experiments.
  </p>
  {skills.map((group) => (
    <p>
      <strong>{group.group}:</strong> {group.items.join(', ')}
    </p>
  ))}

  <h2 id='social-networks'>Social Networks</h2>
  <ul>
    <li>Email: <a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    <li>GitHub: TODO</li>
    <li>Google Scholar / ORCID / Personal CV: TODO</li>
  </ul>

  <h2 id='about-this-site'>About This Site</h2>
  <p>
    This website is built with Astro and Markdown/MDX. It is designed to be permanently hosted
    through GitHub and Vercel or Cloudflare Pages, rather than being a temporary local preview.
  </p>
</PageLayout>
