---
import { type CollectionEntry, getCollection, render } from 'astro:content'

import { TOC } from 'astro-pure/components/pages'
import { Button } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

export const prerender = true

export async function getStaticPaths() {
  const indexes = await getCollection('indexes', ({ data }) => !data.draft)
  return indexes.map((item) => ({
    params: { id: item.id },
    props: { item }
  }))
}

type Props = {
  item: CollectionEntry<'indexes'>
}

const { item } = Astro.props
const { Content, headings } = await render(item)
---

<PageLayout meta={{ title: item.data.title, description: item.data.description }}>
  <Button title='Back' href='/indexes' variant='back' />
  <main class='mt-6 items-start gap-x-10 md:flex lg:mt-10'>
    {!!headings.length && (
      <TOC
        class='animate top-24 min-w-48 basis-60 max-md:hidden md:sticky md:order-2 lg:shrink-0'
        {headings}
      />
    )}

    <article class='min-w-0 grow'>
      <div id='content-header' class='animate'>
        <h1 class='text-2xl font-medium sm:mb-2 sm:text-3xl'>{item.data.title}</h1>
        <p class='mt-2 text-sm text-muted-foreground'>{item.data.description}</p>
        <p class='mt-2 text-xs text-muted-foreground'>
          {item.data.category} · {item.data.type} ·
          {' '}
          {new Date(item.data.updatedDate ?? item.data.publishDate).toLocaleDateString('zh-CN')}
        </p>
      </div>

      <div id='content' class={cn('animate mt-8 max-w-none md:min-w-[45ch] overflow-x-hidden', integ.typography.class)}>
        <Content />
      </div>
    </article>
  </main>
</PageLayout>

