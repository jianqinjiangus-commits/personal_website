---
import PageLayout from '@/layouts/CommonPage.astro'
import { linkApplyInfo, myLinks, references } from '@/data/links'

const headings = [
  { depth: 2, slug: 'my-links', text: 'My Links' },
  { depth: 2, slug: 'friends-references', text: 'Friends / References' },
  { depth: 2, slug: 'apply-links', text: 'Apply Links' }
]

const isTodo = (val: string) => val.toUpperCase().startsWith('TODO')
---

<PageLayout title='Links' {headings}>
  <h2 id='my-links'>My Links</h2>
  <div class='not-prose grid gap-3 sm:grid-cols-2'>
    {myLinks.map((item) => (
      <article class='rounded-xl border p-4'>
        <h3 class='text-base font-medium'>{item.name}</h3>
        <p class='mt-1 text-sm text-muted-foreground'>{item.desc}</p>
        <p class='mt-2 text-sm'>
          {isTodo(item.link) ? (
            <span class='text-muted-foreground'>Coming soon</span>
          ) : (
            <a href={item.link} target={item.link.startsWith('http') ? '_blank' : undefined} rel='noreferrer'>
              {item.link}
            </a>
          )}
        </p>
      </article>
    ))}
  </div>

  <h2 id='friends-references'>Friends / References</h2>
  <div class='not-prose grid gap-3 sm:grid-cols-2'>
    {references.map((item) => (
      <article class='rounded-xl border p-4'>
        <h3 class='text-base font-medium'>{item.name}</h3>
        <p class='mt-1 text-sm text-muted-foreground'>{item.desc}</p>
        <p class='mt-2 text-sm'>
          <a href={item.link} target='_blank' rel='noreferrer'>
            {item.link}
          </a>
        </p>
      </article>
    ))}
  </div>

  <h2 id='apply-links'>Apply Links</h2>
  <p>本站信息 Site information:</p>
  <blockquote class='not-prose grid grid-cols-[auto_1fr] gap-x-2 break-words border-s-4 ps-4'>
    {linkApplyInfo.map((item) => (
      <>
        <span class='text-end'>{item.name}:</span>
        <samp>{item.val}</samp>
      </>
    ))}
  </blockquote>
</PageLayout>
