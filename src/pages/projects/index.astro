---
import PageLayout from '@/layouts/CommonPage.astro'
import { projects } from '@/data/projects'

const groups = Object.entries(
  projects.reduce<Record<string, typeof projects>>((acc, project) => {
    if (!acc[project.category]) acc[project.category] = []
    acc[project.category].push(project)
    return acc
  }, {})
)

const headings = groups.map(([category]) => ({
  depth: 2,
  slug: category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
  text: category
}))

const isTodo = (val: string) => val.toUpperCase().startsWith('TODO')
---

<PageLayout title='Projects' {headings}>
  <p>
    This page lists ongoing project directions and workflow assets. Unknown external URLs are kept
    as TODO and shown as <code>Coming soon</code>.
  </p>

  {groups.map(([category, items]) => {
    const slug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
    return (
      <Fragment>
        <h2 id={slug}>{category}</h2>
        <div class='not-prose grid gap-3 sm:grid-cols-2'>
          {items.map((project) => (
            <article class='rounded-xl border p-4'>
              <h3 class='text-lg font-medium'>{project.name}</h3>
              <p class='mt-2 text-sm text-muted-foreground'>{project.description}</p>
              <p class='mt-2 text-xs text-muted-foreground'>Status: {project.status}</p>
              <p class='mt-2 text-sm'>
                <strong>Source:</strong>{' '}
                {isTodo(project.source) ? (
                  <span class='text-muted-foreground'>Coming soon</span>
                ) : (
                  <a href={project.source} target='_blank' rel='noreferrer'>
                    {project.source}
                  </a>
                )}
              </p>
              <p class='mt-1 text-sm'>
                <strong>Demo:</strong>{' '}
                {isTodo(project.demo) ? (
                  <span class='text-muted-foreground'>Coming soon</span>
                ) : (
                  <a href={project.demo} target='_blank' rel='noreferrer'>
                    {project.demo}
                  </a>
                )}
              </p>
              <ul class='mt-3 flex flex-wrap gap-2'>
                {project.tags.map((tag) => (
                  <li class='rounded-full bg-muted px-2 py-0.5 text-xs'>{tag}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </Fragment>
    )
  })}
</PageLayout>
